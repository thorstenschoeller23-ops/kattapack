# KattaPack: Einstellungen für Apache-Server (die meisten deutschen Webhoster).
# Wird von build.py als ".htaccess" ins Hauptverzeichnis gelegt.
# Jeder Block greift nur, wenn das passende Modul beim Hoster aktiv ist.
# Sonst wird er übersprungen und die Seite läuft trotzdem.
# HTTPS-Weiterleitung bitte im Kundenmenü des Hosters einschalten, nicht hier
# (eine Weiterleitung per .htaccess führt bei manchen Hostern zu einer Endlosschleife).

# Texte komprimiert ausliefern: weniger Datenvolumen, schnellere Seite
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml text/plain
</IfModule>

# Zwischenspeichern im Browser: Wiederkehrende Besucher laden fast nichts neu.
# site.css und site.js haben eine Versionsnummer im Link (?v=…), deshalb dürfen sie lange gelten.
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|ico|png|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^site\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|txt)$|^fonts\.css$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Sicherheit: nur eigene Dateien laden, nicht in fremde Seiten einbetten lassen
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Frame-Options "DENY"
  # Erst aktiv, wenn die Seite per HTTPS läuft (über HTTP ignorieren Browser die Zeile)
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Interne Dateien nicht ausliefern, falls sie versehentlich mit hochgeladen werden
<FilesMatch "(\.py$|^LIESMICH\.txt$|^_headers$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
